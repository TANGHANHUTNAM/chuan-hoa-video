node_modules/
dist/

# 85 MB portable Node.js, fetched by `npm run bundle-runtime`. Rebuildable, so
# it does not belong in version control.
runtime/

# Holds APP_ENCRYPTION_KEY, which is the only thing that can read the encrypted SSH
# credentials and stream keys on the Sheet. Whoever holds this file has root on your
# VPS and can take over your live streams: hand it to a teammate deliberately, never
# commit it.
# A pattern rather than a list — .env.development and .env.test used to slip through.
.env
.env.*
!.env.example

# SQLite database: SSH private keys and Facebook stream keys live here.
data/
*.db
*.db-journal
*.db-wal
*.db-shm
npm-debug.log*
.DS_Store

# Chuẩn Hoá Video workspace: the user's own footage, often gigabytes per file.
# The folders stay in the repo (via their README) so somebody who clones sees where
# the video goes without having to run the tool first.
video-can-chuan-hoa/*
video-da-chuan-hoa/*
!video-can-chuan-hoa/README.txt
!video-da-chuan-hoa/README.txt

# Holds THIS install's Sheets token, pre-filled for convenience. The token is the
# only thing guarding an unauthenticated Apps Script URL that can read and write the
# spreadsheet, so it must never be published. Code.gs (the template, with a
# placeholder) is committed instead.
deploy/apps-script/Code-DAN-VAO-SHEET.gs

# Windows/editor noise
Thumbs.db
desktop.ini
.vscode/
.idea/
